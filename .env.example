# --- Base de datos (obligatoria para tener cuentas) --------------------------------------------
# Supabase → botón «Connect» → «Transaction pooler» (puerto 6543). NO uses «Direct connection»:
# solo funciona por IPv6 y Vercel no puede conectarse.
# Si la contraseña tiene símbolos (@ : / # ?), cámbiala por una solo con letras y números.
DATABASE_URL=postgresql://postgres.TU_REF:TU_CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Dirección pública del sitio (para los enlaces de los correos) -----------------------------
APP_URL=https://crecer-two.vercel.app

# --- Correo para recuperar contraseñas (SMTP) --------------------------------------------------
# Ejemplo con Gmail y una «contraseña de aplicación» (https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=abcdefghijklmnop
# Opcional: remitente visible. Por defecto «Crecer <SMTP_USER>».
# MAIL_FROM="Crecer <tu-cuenta@gmail.com>"
